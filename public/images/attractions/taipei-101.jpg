<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4C78E8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1D4ED8;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#grad)" />
  <circle cx="700" cy="80" r="120" fill="rgba(255,255,255,0.08)" />
  <circle cx="100" cy="420" r="160" fill="rgba(0,0,0,0.06)" />
  <g transform="translate(40, 380)">
    <rect width="720" height="80" rx="12" fill="rgba(0,0,0,0.4)" backdrop-filter="blur(10px)" />
    <text x="30" y="48" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="bold" fill="#FFF8ED">台北101 Taipei 101</text>
    <text x="690" y="48" text-anchor="end" font-family="'Plus Jakarta Sans', sans-serif" font-size="20" fill="#FFD166">台北</text>
  </g>
</svg>
